{
  "name": "rpdistill-studio",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "electron .",
    "smoke": "electron . --studio-smoke",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "electron": "40.0.0",
    "typescript": "5.8.3",
    "esbuild": "0.25.10",
    "@types/node": "22.15.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.rpdistill.studio",
    "productName": "RPDistill Studio",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RPDistill-Studio-${version}-win-${arch}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPDistill Studio",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
